#!/usr/bin/env tclsh
# schem -- command-line runner for the Schem electrical interpreter.
#
#   schem path/to/board.schem.tcl     run a schematic and print its report
#   schem -i                          interactive shell with the API loaded
#   schem -v                          print version
#
# A schematic file is a Tcl script that builds a schematic with the Schem
# workbench API (schem::new, $s add, $s wire, ...).  The runner makes the
# variable `s` available pre-bound to a fresh schematic named after the
# file, so trivial boards can skip the boilerplate; files may also create
# their own schematics.  After sourcing, if the file left `s` solvable, its
# report is printed.

set bindir [file dirname [file normalize [info script]]]
source [file join $bindir .. src schem.tcl]

proc usage {} {
    puts stderr "usage: schem <board.schem.tcl> | -i | -v"
    exit 2
}

if {[llength $argv] == 0} { usage }

switch -- [lindex $argv 0] {
    -v - --version {
        puts "schem [schem::version]"
        exit 0
    }
    -i - --interactive {
        puts "Schem [schem::version] interactive shell."
        puts "A schematic `s` is ready.  Try: \$s add battery B -emf 9 ; \$s report"
        set ::s [schem::new interactive]
        # Hand control to the standard Tcl REPL.
        while {![eof stdin]} {
            puts -nonewline "schem> " ; flush stdout
            if {[gets stdin line] < 0} break
            if {[catch {uplevel #0 $line} res]} {
                puts "error: $res"
            } elseif {$res ne ""} {
                puts $res
            }
        }
        exit 0
    }
    default {
        set file [lindex $argv 0]
        if {![file readable $file]} {
            puts stderr "schem: cannot read \"$file\""
            exit 1
        }
        set name [file rootname [file tail $file]]
        set s [schem::new $name]
        # Expose the file's own argv tail.
        set argv [lrange $argv 1 end]
        source $file
        # If the board built into `s` and has a ground, print its report.
        if {[catch {$s components} comps]} { exit 0 }
        if {[llength $comps] > 0} {
            puts [$s report]
        }
        exit 0
    }
}
